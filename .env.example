# Brain provider configuration
BRAIN_PROVIDER=anthropic
BRAIN_FALLBACK_PROVIDER=ollama

# API keys for cloud providers (if used)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: local model paths
LLAMACPP_MODEL_PATH=path/to/your/model.gguf

# TTS configuration
TTS_ENGINE=piper  # piper or cloud
PIPER_MODEL_PATH=path/to/piper/model.onnx
PIPER_SPEAKER_ID=0

# Network
HERMES_API_URL=http://localhost:5000  # URL of the Hermes agent

# Self-improve (optional)
SELF_IMPROVE_ENABLED=false
SELF_IMPROVE_INTERVAL_HOURS=24
GITHUB_TOKEN=your_github_token_here  # for opening PRs
GITHUB_REPOSITORY=Astronyz/Akemi

# Other settings
LOG_LEVEL=INFO
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024
VAD_AGGRESSIVENESS=2  # 0-3, higher means more aggressive in filtering non-speech
SCREENSHOT_INTERVAL=1.0  # seconds
SCREENSHOT_CACHE_SIZE=10  # number of screenshots to keep in memory
OCR_LANGUAGE=eng