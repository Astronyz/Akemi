# =============================================================================
# Akemi - Autonomous AI Agent Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All settings can also be set via environment variables.
# Nested settings use double underscore: BRAIN__PROVIDER=anthropic
# =============================================================================

# -----------------------------------------------------------------------------
# BRAIN PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Primary LLM provider: anthropic, openai, ollama, llamacpp
BRAIN__PROVIDER=anthropic

# Fallback provider if primary fails
BRAIN__FALLBACK_PROVIDER=ollama

# Anthropic (Claude) - requires API key
BRAIN__ANTHROPIC_API_KEY=your_anthropic_api_key_here
# BRAIN__ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (GPT) - requires API key
BRAIN__OPENAI_API_KEY=your_openai_api_key_here
# BRAIN__OPENAI_MODEL=gpt-4o

# Ollama (local) - requires Ollama running
BRAIN__OLLAMA_HOST=http://localhost:11434
BRAIN__OLLAMA_MODEL=llama3.1:8b

# llama.cpp (local) - requires .gguf model file
BRAIN__LLAMACPP_MODEL_PATH=path/to/your/model.gguf
BRAIN__LLAMACPP_N_CTX=4096
BRAIN__LLAMACPP_N_GPU_LAYERS=-1  # -1 = all layers on GPU

# Generation parameters
BRAIN__TEMPERATURE=0.7
BRAIN__MAX_TOKENS=2048
BRAIN__SYSTEM_PROMPT="Você é a Akemi, um assistente pessoal autônomo que roda em background no Windows. Responda em português de forma natural e concisa."

# -----------------------------------------------------------------------------
# AUDIO CAPTURE SETTINGS
# -----------------------------------------------------------------------------
# Output sample rate for VAD/STT (must be 16000 for webrtcvad)
AUDIO__SAMPLE_RATE=16000

# Output channels (mono=1)
AUDIO__CHANNELS=1

# VAD aggressiveness (0-3, higher = more aggressive filtering)
AUDIO__VAD_AGGRESSIVENESS=2

# VAD frame duration in ms (10, 20, or 30)
AUDIO__VAD_FRAME_MS=20

# Frames per callback (aligned to VAD frame: 320 @ 16kHz = 20ms)
AUDIO__CHUNK_SIZE=320

# Ring buffer size in chunks
AUDIO__BUFFER_SIZE_CHUNKS=100

# -----------------------------------------------------------------------------
# SPEECH-TO-TEXT (STT) SETTINGS
# -----------------------------------------------------------------------------
# Model size: tiny, base, small, medium, large-v3
STT__MODEL_SIZE=base

# Device: auto, cpu, cuda
STT__DEVICE=auto

# Compute type: auto, int8, float16, float32
STT__COMPUTE_TYPE=auto

# Language code (None = auto-detect). pt = Portuguese
STT__LANGUAGE=pt

# Beam size for decoding
STT__BEAM_SIZE=5

# Use VAD filter in whisper
STT__VAD_FILTER=true

# VAD filter parameters (JSON)
STT__VAD_PARAMETERS={"threshold": 0.5, "min_speech_duration_ms": 250}

# -----------------------------------------------------------------------------
# TEXT-TO-SPEECH (TTS) SETTINGS
# -----------------------------------------------------------------------------
# Engine: piper (local) or cloud
TTS__ENGINE=piper

# Piper (local) - requires .onnx model file
TTS__PIPER_MODEL_PATH=path/to/piper/model.onnx
TTS__PIPER_SPEAKER_ID=0
TTS__PIPER_LENGTH_SCALE=1.0
TTS__PIPER_NOISE_SCALE=0.667
TTS__PIPER_NOISE_W=0.8

# Cloud TTS (future)
# TTS__CLOUD_PROVIDER=elevenlabs
# TTS__CLOUD_API_KEY=your_api_key
# TTS__CLOUD_VOICE=voice_id

# -----------------------------------------------------------------------------
# VISION / SCREEN CAPTURE SETTINGS
# -----------------------------------------------------------------------------
# Seconds between screenshots
VISION__SCREENSHOT_INTERVAL=1.0

# Number of screenshots to keep in memory
VISION__SCREENSHOT_CACHE_SIZE=10

# Tesseract OCR language code (por = Portuguese, eng = English)
VISION__OCR_LANGUAGE=por

# Tesseract config options
VISION__OCR_CONFIG=--psm 6

# Frame difference threshold (0-1, higher = more sensitive)
VISION__FRAME_DIFF_THRESHOLD=0.05

# Monitor index to capture (0 = primary)
VISION__MONITOR_INDEX=0

# -----------------------------------------------------------------------------
# NETWORK / API SETTINGS
# -----------------------------------------------------------------------------
# Control API bind address
NET__CONTROL_API_HOST=127.0.0.1

# Control API port
NET__CONTROL_API_PORT=8765

# Hermes agent base URL
NET__HERMES_API_URL=http://localhost:5000

# Hermes API timeout (seconds)
NET__HERMES_TIMEOUT=30.0

# -----------------------------------------------------------------------------
# STORAGE / DATABASE SETTINGS
# -----------------------------------------------------------------------------
# SQLite database path
STORAGE__DB_PATH=data/akemi.db

# Log retention days
STORAGE__LOG_RETENTION_DAYS=30

# Max audio event logs to keep
STORAGE__MAX_AUDIO_LOGS=10000

# Max vision event logs to keep
STORAGE__MAX_VISION_LOGS=5000

# -----------------------------------------------------------------------------
# SELF-IMPROVE SETTINGS
# -----------------------------------------------------------------------------
# Enable self-improvement (creates PRs on GitHub)
SELF_IMPROVE__ENABLED=false

# Hours between improvement runs
SELF_IMPROVE__INTERVAL_HOURS=24

# GitHub token for creating PRs (needs repo write access)
SELF_IMPROVE__GITHUB_TOKEN=your_github_token_here

# Target repository for PRs (owner/repo)
SELF_IMPROVE__GITHUB_REPOSITORY=astronyz/akemi

# Maximum PRs per day
SELF_IMPROVE__MAX_PRS_PER_DAY=1

# Run tests before opening PR
SELF_IMPROVE__TEST_BEFORE_PR=true

# Auto-rollback if service crashes after merge
SELF_IMPROVE__ROLLBACK_ON_FAILURE=true

# -----------------------------------------------------------------------------
# LOGGING SETTINGS
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG__LEVEL=INFO

# Log format: json or console
LOG__FORMAT=json

# Log file path (None = stdout only)
LOG__FILE_PATH=logs/akemi.log

# Max log file size before rotation (bytes)
LOG__MAX_BYTES=10000000

# Number of rotated log files to keep
LOG__BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# OTHER SETTINGS
# -----------------------------------------------------------------------------
# Debug mode
DEBUG=false